[Unit]
Description=Polymarket Rust HotPath Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/polymarket-bot/Arb-Bot
Environment=RUST_LOG=polymarket_rust_service=info,polymarket_engine=warn
Environment=ENV_FILE=/opt/polymarket-bot/Arb-Bot/.env
EnvironmentFile=-/opt/polymarket-bot/Arb-Bot/.env
ExecStart=/opt/polymarket-bot/Arb-Bot/rust_engine/target/release/polymarket_rust_service
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
