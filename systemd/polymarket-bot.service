[Unit]
Description=Polymarket Arbitrage Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/polymarket-arb-bot
ExecStart=/home/ubuntu/polymarket-arb-bot/venv/bin/python -m src.main
Restart=always
RestartSec=10

# Environment
EnvironmentFile=/home/ubuntu/polymarket-arb-bot/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-bot

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/polymarket-arb-bot/data /home/ubuntu/polymarket-arb-bot/logs

[Install]
WantedBy=multi-user.target
