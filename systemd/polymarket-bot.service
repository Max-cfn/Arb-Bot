[Unit]
Description=Polymarket Arbitrage Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/polymarket-bot/Arb-Bot
ExecStart=/opt/polymarket-bot/Arb-Bot/venv/bin/python -m src.main
Restart=always
RestartSec=10

# Environment
EnvironmentFile=/opt/polymarket-bot/Arb-Bot/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-bot

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/polymarket-bot/Arb-Bot/data /opt/polymarket-bot/Arb-Bot/logs

[Install]
WantedBy=multi-user.target
