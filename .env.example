# ==========================================================
# Polymarket Arb-Bot — .env.example (safe placeholders only)
# ==========================================================
# NOTE:
# - Never put real secrets in this file.
# - Copy to `.env` and fill with your own private values.

# === RUNTIME MODE ===
EXECUTION_MODE=dryrun
RUST_HOTPATH_ENABLED=1

# === CLOB API / TRADING AUTH ===
CLOB_BASE_URL=https://clob.polymarket.com
CLOB_CHAIN_ID=137
CLOB_SIGNATURE_TYPE=0

# Wallet / signer (private)
CLOB_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
CLOB_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS

# L2 API creds (private)
CLOB_API_KEY=YOUR_CLOB_API_KEY
CLOB_API_SECRET=YOUR_CLOB_API_SECRET_BASE64
CLOB_API_PASSPHRASE=YOUR_CLOB_API_PASSPHRASE

# === DISCORD WEBHOOKS ===
DISCORD_WEBHOOK_HEALTH=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_OPS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_DAILY=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_OPPORTUNITIES=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_EXECUTIONS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_EXECUTIONS_INFO=https://discord.com/api/webhooks/xxx/yyy

# === DETECTION / UNIVERSE PARAMS ===
MIN_EDGE_PERCENT=0.5
MIN_LIQUIDITY_USD=100
MAX_MARKETS_WATCH=5000
SCAN_INTERVAL_SECONDS=1
MARKET_MIN_LIQUIDITY_USD=500
MARKET_MIN_VOLUME_USD=500
TARGET_SIZE_USD=100

# === SAFETY BUFFERS ===
BUFFER_LIQUID_PERCENT=0.5
BUFFER_ILLIQUID_PERCENT=1.0
ILLIQUID_THRESHOLD_USD=1000

# === EXECUTION TUNING ===
CLOB_MIN_ORDER_USD=1.0
CLOB_MIN_ORDER_SHARES=5
MIN_EXECUTION_EDGE_PERCENT=0.5
MAX_EDGE_DECAY_BPS=25
TRADING_ENABLED=1
POLY_CONTROL_FILE=data/control.json
PANIC_PARTIAL_COUNT=3
PANIC_PARTIAL_WINDOW_MIN=10
MIN_SHARES=1
CLOB_ORDER_TIMEOUT_S=2
CLOB_POLL_INTERVAL_S=0.05
WAIT_FOR_BOTH_MS=500
EXEC_DEDUP_SECONDS=0

# One-shot / kill style controls
ONE_SHOT_TRADE=0
MAX_ONE_SHOT_TRADES=0

# Debug noise controls
OPS_DEBUG=0
OPS_WS_DEBUG=0

# === DATABASE ===
DB_PATH=data/opportunities.db